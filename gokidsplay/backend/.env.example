# ============================================================
# Go Kids Play Backend — Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit the actual .env file
# ============================================================

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False

# Allowed hosts — comma separated, add your VPS domain/IP
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (default is SQLite for dev; switch to PostgreSQL on VPS)
# For SQLite (dev): leave blank
# For PostgreSQL (VPS):
# DATABASE_URL=postgresql://gokidsplay_user:password@localhost:5432/gokidsplay_db

# CORS — comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://yourdomain.com

# ============================================================
# EMAIL (SMTP — works with Gmail, Mailgun, SendGrid, etc.)
# ============================================================
EMAIL_ENABLED=False
EMAIL_BOOKING_ENABLED=False
EMAIL_DEBUG_MODE=True

# Switch to real SMTP backend when ready:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=info@Go Kids Play.co.uk
EMAIL_SENDER_NAME=Go Kids Play Leicester

# ============================================================
# PAYMENT — SumUp
# ============================================================
PAYMENT_MODE=mock
# Set to: sumup (when live)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_CHECKOUT_REDIRECT_URL=https://yourdomain.com/book/success

# ============================================================
# FRONTEND URL (for email links, redirects)
# ============================================================
FRONTEND_URL=http://localhost:5000

# ============================================================
# ADMIN
# ============================================================
ADMIN_JWT_SECRET=your-admin-jwt-secret-here
ADMIN_TOKEN_EXPIRE_HOURS=8

# Google reviews on the Testimonies page: a Google Cloud API key with "Places API (New)" enabled
GOOGLE_PLACES_API_KEY=

# Payments: 'sumup' for live card payments; 'mock' = test checkout page, no money taken (DEBUG=True only)
PAYMENT_MODE=sumup
# Public address of this backend (Azure sets WEBSITE_HOSTNAME automatically; set this for a custom domain)
BACKEND_URL=https://api.gokidsplay.co.uk

# Shared secret for the scheduled-jobs endpoint (same value as the GitHub secret CRON_SECRET)
CRON_SECRET=
